# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=replace-with-a-random-secret-of-at-least-32-characters
APP_ENV=development
APP_TIMEZONE=Asia/Manila

# Database Configuration
DB_DRIVER=mysql
DB_HOST=your-managed-mysql-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name
DB_CHARSET=utf8mb4
DB_PREFIX=

# API and browser deployment
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REFRESH_TOKEN_KEY=use-a-different-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGIN=https://your-vercel-domain.vercel.app
